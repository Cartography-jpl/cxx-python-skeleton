#pragma once
// lib/skeleton_config.h: made by configure from lib/skeleton_config.h.in.
// Installed headers include it (through generic_object.h), so it defines
// only SKELETON_* and CXX_PYTHON_RULES_* macros. What only the library
// build needs (autoconf's PACKAGE, HAVE_*, the addr2line path) is in
// skeleton_build_config.h, which isn't installed.

// Namespace of GenericObject and of the cxx_python_rules code.
#define CXX_PYTHON_RULES_NAMESPACE Skeleton

// Boost.Serialization support (configure --without-boost-serialization
// turns it off).
@skeleton_no_serialization@#define SKELETON_HAVE_BOOST_SERIALIZATION 1
@skeleton_no_serialization@#define CXX_PYTHON_RULES_HAVE_BOOST_SERIALIZATION 1
