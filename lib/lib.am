# Set up for the library
lib_LTLIBRARIES += libskeleton.la
#=================================================================
# Unit test

check_PROGRAMS = skeleton_test_all
skeleton_test_all_SOURCES += @srclib@/test_all.cc
skeleton_test_all_LDADD = libskeleton.la 
skeleton_test_all_LDFLAGS = -no-install 
skeleton_test_all_CPPFLAGS = $(AM_CPPFLAGS)
TESTS+= @srclib@/test_all.sh
EXTRA_DIST+= @srclib@/test_all.sh

#=================================================================
# List of source files
skeletoninc_HEADERS+= @srclib@/skeleton_serialize_support.h
skeletoninc_HEADERS+= @srclib@/generic_object.h
libskeleton_la_SOURCES+= @srclib@/generic_object.cc
skeletoninc_HEADERS+= @srclib@/printable.h
skeletoninc_HEADERS+= @srclib@/skeleton_exception.i
skeletoninc_HEADERS+= @srclib@/iostream_swig.h
libskeleton_la_SOURCES+= @srclib@/iostream_swig.cc
skeletoninc_HEADERS+= @srclib@/blitz_array_serialize_support.h
libskeleton_la_SOURCES+= @srclib@/blitz_array_serialize_support.cc

# Files that contain SWIG wrapper information.
skeletonswiginc_HEADERS+= @srclib@/skeleton_common.i
skeletonswiginc_HEADERS+= @srclib@/skeleton_shared_ptr.i
SWIG_SRC += @swigsrc@/skeleton_exception_wrap.cc
skeletonswiginc_HEADERS+= @srclib@/skeleton_exception.i
SWIG_SRC += @swigsrc@/generic_object_wrap.cc
skeletonswiginc_HEADERS += @srclib@/generic_object.i
SWIG_SRC += @swigsrc@/iostream_swig_wrap.cc

# Test files
EXTRA_DIST+= @srclib@/unit_test_support.h
EXTRA_DIST+= @srclib@/global_fixture.h
skeleton_test_all_SOURCES+= @srclib@/global_fixture.cc
skeleton_test_all_SOURCES+= @srclib@/global_fixture_default.cc
skeleton_test_all_SOURCES+= @srclib@/printable_test.cc
skeleton_test_all_SOURCES+= @srclib@/blitz_array_serialize_support_test.cc

# Variables used in testing
export abs_top_srcdir 
export abs_top_builddir
export testdatadir
export run_test = *

AM_CPPFLAGS+= -I$(srcdir)/@srclib@
# To pick up generated skeleton_config.h file
AM_CPPFLAGS+= -I@srclib@

#=================================================================
# Normally check builds all the libraries, and tests all the pyton. This
# version builds just what is needed for C++ unit tests, which is faster
# to do during development.

skeleton-check: $(BUILT_SOURCES)
	$(MAKE) $(AM_MAKEFLAGS) skeleton-check-am

skeleton-check-am: skeleton_test_all
	@echo "====================================================="
	@echo "This just builds and runs the skeleton C++ unit tests"
	@echo "(useful during development). It does run the python "
	@echo "tests, use check for that"
	@echo "====================================================="
	$(srcdir)/$(srclib)/test_all.sh

# Allow searchs for .i, .h. and .cc files in this directory
vpath %.cc $(srcdir)/@srclib@
vpath %.h $(srcdir)/@srclib@
vpath %.i $(srcdir)/@srclib@
