# clang-tidy checks for "make lint" (the same file is used in cxx-python-skeleton
# and geocal). The code is clean for all of them, so new code keeps to them.
# Add a check here only after the code has been cleaned up for it.
Checks: >
  -*,
  modernize-use-override,
  modernize-use-nullptr,
  modernize-use-noexcept,
  modernize-use-equals-default,
  modernize-make-shared,
  modernize-loop-convert,
  modernize-deprecated-headers,
  google-explicit-constructor,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-prefer-member-initializer,
  modernize-use-using,
  modernize-use-default-member-init,
  modernize-pass-by-value,
  performance-unnecessary-value-param,
  readability-container-contains,
  modernize-use-ranges,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  modernize-concat-nested-namespaces,
  modernize-avoid-c-arrays,
  modernize-use-designated-initializers,
  readability-redundant-typename,
  readability-redundant-inline-specifier,
  performance-*,
  misc-use-anonymous-namespace,
  cppcoreguidelines-special-member-functions
CheckOptions:
  cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor: true
  cppcoreguidelines-special-member-functions.AllowMissingMoveFunctionsWhenCopyIsDeleted: true
# geocal uses the same file, but its "make lint" fails on a check until
# geocal's code is cleaned up for it, so geocal adds the checks after
# bugprone-* one at a time.
# cppcoreguidelines-special-member-functions: a class that declares any of
# the five special members declares them all, except that a lone defaulted
# destructor, and missing moves when copying is deleted, are fine.
# Off: bugprone-easily-swappable-parameters flags every function with two
# adjacent int (line, sample) or string parameters, which is most of the
# geocal API. modernize-use-std-print is not wanted (it would rewrite
# stream output that is supposed to stay a stream).
# Report on our headers too, but not on generated wrappers, vendored code or
# copies of upstream code.
HeaderFilterRegex: '.*/(lib|cxx_python_rules/lib|cxx_python_rules/nanobind)/.*'
ExcludeHeaderFilterRegex: '.*/(bindings|thirdparty|boost_fix)/.*|.*/Support/boost/.*|.*/gc_shared_ptr.h|.*/serialize_shared_ptr.h'
