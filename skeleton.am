# Stuff specific to skeleton

# Build these up as we go
libskeleton_la_SOURCES = 
# Python binding sources (nanobind), cxx_python_rules/nanobind/nanobind.am
NB_SRC =
libskeleton_la_LDFLAGS =
skeletonincdir = @includedir@/skeleton
skeletoninc_HEADERS =
skeleton_test_all_SOURCES = 
dist_installskeleton_SCRIPTS = 
DIST_HOOK = 
libskeleton_la_CPPFLAGS = $(AM_CPPFLAGS) $(BOOST_CPPFLAGS) $(BLITZ_CFLAGS)

libskeleton_la_LDFLAGS+= -R $(BOOST_LIBDIR) -L$(BOOST_LIBDIR)
# Only the compiled Boost libraries libskeleton uses: iostreams (gzip) and
# serialization. regex and filesystem were replaced by std; configure
# still looks for them
# (config/m4/ac_boost.m4 is shared with geocal, which needs them).
libskeleton_la_LDFLAGS+= $(BOOST_IOSTREAMS_LIB)
libskeleton_la_LDFLAGS+= $(BOOST_SERIALIZATION_LIB)

# Include blitz in builds
libskeleton_la_LDFLAGS+= $(BLITZ_LIBS)
# Boost.Stacktrace (header only, in skeleton_exception.cc) uses dladdr,
# which is in libdl for glibc before 2.34 (e.g. the conda sysroot).
libskeleton_la_LDFLAGS+= -ldl

EXTRA_DIST+= README.md bootstrap
EXTRA_DIST+= config/m4_local/README
# Automake doesn't seem to include two directories of m4 macros, so explicitly
# add
EXTRA_DIST+= config/m4

#=================================================================
# Test coverage report. This needs a build configured with
#   CXXFLAGS="-O0 -g --coverage" LDFLAGS="--coverage"
# followed by "make install". The python tests are run against the
# python source tree (put first on PYTHONPATH, so another installed copy
# can't shadow it). This then runs the C++ and python
# tests and writes a report to coverage/ (index.html for the C++, and
# python/index.html for the python). Needs gcovr and pytest-cov. This
# isn't part of "make check". --merge-lines counts a line in a template as covered if any
# instance runs it (otherwise a template like Observer<T> shows as
# uncovered for every instance that a test doesn't use).
GCOVR = gcovr
coverage:
	find . -name '*.gcda' -delete
	rm -rf coverage
	$(MKDIR_P) coverage/python
	$(MAKE) $(AM_MAKEFLAGS) skeleton-check
	source script/setup_skeleton.sh && \
	  cd $(srcdir)/@srcpython@ && \
	  PYTHONPATH=$(abs_top_srcdir)/@srcpython@:$$PYTHONPATH \
	  COVERAGE_FILE=$(abs_builddir)/coverage/.coverage $(PYTEST) -q \
	  -p no:cacheprovider --cov=skeleton --cov-report=term \
	  --cov-report=html:$(abs_builddir)/coverage/python tests
	$(GCOVR) -r $(realpath $(abs_top_srcdir)) . \
	  --filter '$(realpath $(abs_top_srcdir))/(lib|cxx_python_rules/lib)/' \
	  --exclude '.*_test\.cc' --exclude '.*golden_archive_generator.*' \
	  --exclude '.*(global_fixture|test_all).*' \
	  --merge-lines --print-summary --html-details coverage/index.html
	@echo "Coverage report in coverage/index.html and coverage/python/index.html"

.PHONY: coverage

#=================================================================
# C++ formatting and lint. "make format" formats the C++ with clang-format
# (.clang-format and .clang-format-ignore at the top of the source tree),
# "make format-check" only checks it (fails if a file isn't formatted).
# "make lint" runs clang-tidy with the checks in .clang-tidy and fails on any
# finding. clang-format and clang-tidy come from the pixi env (clang-tools);
# keep the same clang-format version for everyone, since the formatting
# differs slightly between versions. The file lists come from git, so these
# work in a git checkout only. The python code has the same targets in
# python/Makefile (ruff).
#
# lint also writes compile_commands.json (with the extra flags clangd needs,
# see script/make_compile_commands.py), so it can be linked into the source
# tree for clangd. clang-tidy runs on the library, test, generator and
# python binding sources in the source tree (not files generated in the
# build directory, and not nanobind's own source, nb_combined.cc).
CLANG_FORMAT = clang-format
CLANG_TIDY_FLAGS = --quiet --warnings-as-errors='*' \
  --config-file=$(abs_top_srcdir)/.clang-tidy
LINT_NJOB = 10
FORMAT_FILES = 'lib/*.h' 'lib/*.cc' 'cxx_python_rules/lib/*.h' 'cxx_python_rules/lib/*.cc' \
  'cxx_python_rules/nanobind/*.h' 'cxx_python_rules/nanobind/*.cc'

format:
	cd $(srcdir) && git ls-files $(FORMAT_FILES) | xargs -r $(CLANG_FORMAT) -i

format-check:
	cd $(srcdir) && git ls-files $(FORMAT_FILES) | \
	  xargs -r $(CLANG_FORMAT) --dry-run --Werror

lint:
	$(PYTHON) $(srcdir)/script/make_compile_commands.py --clangd \
	  libskeleton.la skeleton_test_all golden_archive_generator _bindings.la \
	  _skeleton_downstream.la
	$(PYTHON) -c 'import json, os; src = os.path.realpath("$(abs_top_srcdir)") + "/"; [print(e["file"]) for e in json.load(open("compile_commands.json")) if os.path.realpath(e["file"]).startswith(src) and not e["file"].endswith("nb_combined.cc")]' \
	  > lint_files.txt
	@test -s lint_files.txt || { echo "lint: no source files found in compile_commands.json"; exit 1; }
	xargs -r -P $(LINT_NJOB) -n 1 sh $(srcdir)/script/run_clang_tidy.sh $(CLANG_TIDY_FLAGS) < lint_files.txt
	@echo "clang-tidy: no findings in $$(wc -l < lint_files.txt) files"

.PHONY: format format-check lint
