# Automake rules for a nanobind python extension module, the nanobind
# replacement for cxx_python_rules.am. Include from the top level .am file,
# after setting:
#
#   NB_SRC              binding source files (the *_nb.cc files and the
#                       file with NB_MODULE)
#   NB_LIBADD           the C++ library the bindings wrap
#   NB_DOXYGEN_INPUT    headers to take docstrings from
#   pkgpythoncxxdir    where the python package goes
#   pkgpythoncxx_LTLIBRARIES (set, possibly empty, before this file and
#                       before adding other modules to it)
#
# The module is <package>/_bindings, with the
# python files from cxx_python_rules/ next to it. configure needs AC_NANOBIND
# (config/m4/ac_nanobind.m4).

if BUILD_PYTHON_BINDINGS
# nanobind's own source, with its own flags (none of our warnings).
noinst_LTLIBRARIES += libnanobind_core.la
libnanobind_core_la_SOURCES = @cxxpythonrules@/nanobind/nb_combined.cc
libnanobind_core_la_CPPFLAGS = $(PYTHON_CPPFLAGS) $(NANOBIND_CPPFLAGS) -I$(NANOBIND_SRCDIR)
libnanobind_core_la_CXXFLAGS = -std=c++23 -O2 -fPIC -fvisibility=hidden -fno-strict-aliasing

pkgpythoncxx_LTLIBRARIES += _bindings.la
_bindings_la_SOURCES = $(NB_SRC)
_bindings_la_SOURCES+= @cxxpythonrules@/nanobind/cxx_python_rules_nb.cc
nodist__bindings_la_SOURCES = nb_docstrings.cc
_bindings_la_CPPFLAGS = $(AM_CPPFLAGS) $(PYTHON_CPPFLAGS) $(NANOBIND_CPPFLAGS)
_bindings_la_CPPFLAGS+= -I$(srcdir)/@cxxpythonrules@/nanobind -I$(srcdir)/@cxxpythonrules@/lib
_bindings_la_CPPFLAGS+= -DCXX_PYTHON_RULES_NB_PACKAGE='"$(notdir $(pkgpythoncxxdir))"'
# Not -fvisibility=hidden (nanobind recommends it, and nanobind's own code
# above has it): the binding code instantiates Boost.Serialization
# templates for library classes (director serialization), and with hidden
# visibility the module gets its own copies of their singletons, separate
# from the library's, which breaks serialization of those classes.
_bindings_la_CXXFLAGS = $(AM_CXXFLAGS)
# No -lpython: the interpreter provides the symbols.
_bindings_la_LDFLAGS = -module -avoid-version -shared
_bindings_la_LIBADD = libnanobind_core.la $(NB_LIBADD)

pkgpythoncxx_PYTHON = @cxxpythonrules@/__init__.py
pkgpythoncxx_PYTHON+= @cxxpythonrules@/all.py
pkgpythoncxx_PYTHON+= @cxxpythonrules@/_nanobind_support.py
pkgpythoncxx_DATA = @cxxpythonrules@/py.typed

# Docstrings from the doxygen documentation of NB_DOXYGEN_INPUT. Without
# doxygen, the table is empty.
nb_docstrings.cc: $(NB_DOXYGEN_INPUT) @cxxpythonrules@/nanobind/doxy2nanobind.py @cxxpythonrules@/nanobind/doxygen_nanobind.cfg
	rm -rf nb_doc && mkdir -p nb_doc
	if test -n "$(DOXYGEN)" -a "$(DOXYGEN)" != "no"; then \
	  OUTDIR=nb_doc INPUT="$(NB_DOXYGEN_INPUT)" $(DOXYGEN) $(srcdir)/@cxxpythonrules@/nanobind/doxygen_nanobind.cfg > /dev/null; \
	fi
	$(PYTHON) $(srcdir)/@cxxpythonrules@/nanobind/doxy2nanobind.py nb_doc/xml $@.tmp
	mv $@.tmp $@
	rm -rf nb_doc
MOSTLYCLEANFILES += nb_docstrings.cc

# Python stubs (.pyi) for mypy and editors, from the built module.
nb_pyi/_bindings.pyi: _bindings.la
	rm -rf nb_pyi && mkdir -p nb_pyi/$(notdir $(pkgpythoncxxdir))
	cp $(srcdir)/@cxxpythonrules@/__init__.py $(srcdir)/@cxxpythonrules@/_nanobind_support.py nb_pyi/$(notdir $(pkgpythoncxxdir))/
	cp .libs/_bindings$(PYTHON_EXT_SUFFIX_SO) nb_pyi/$(notdir $(pkgpythoncxxdir))/ 2>/dev/null || cp .libs/_bindings.so nb_pyi/$(notdir $(pkgpythoncxxdir))/
	cd nb_pyi && PYTHONPATH=.:$${PYTHONPATH} LD_LIBRARY_PATH=$(abs_top_builddir)/.libs:$${LD_LIBRARY_PATH} \
	  $(SANITIZER_PYTHON_ENV) LD_PRELOAD="$(SANITIZER_PRELOAD) $${LD_PRELOAD}" \
	  $(PYTHON) -m nanobind.stubgen -m $(notdir $(pkgpythoncxxdir))._bindings -o _bindings.pyi -q
	rm -rf nb_pyi/$(notdir $(pkgpythoncxxdir))
nodist_pkgpythoncxx_DATA = nb_pyi/_bindings.pyi
MOSTLYCLEANFILES += nb_pyi/_bindings.pyi
endif

EXTRA_DIST+= @cxxpythonrules@/nanobind/i_to_nanobind.py
EXTRA_DIST+= @cxxpythonrules@/nanobind/doxy2nanobind.py
EXTRA_DIST+= @cxxpythonrules@/nanobind/doxygen_nanobind.cfg
EXTRA_DIST+= @cxxpythonrules@/nanobind/README.md
