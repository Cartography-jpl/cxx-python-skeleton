# Rules shared by projects using swig_rules. Since phase S6 of
# claude_notes/implementation_plan.md the python bindings use nanobind
# (swig_rules/nanobind/nanobind.am); the name swig_rules is historical.

EXTRA_DIST+= @swigrules@/README.md
EXTRA_DIST+= CMakeLists.txt
EXTRA_DIST+= @swigrules@/lib/generic_object.cc.sample
EXTRA_DIST+= @swigrules@/lib/generic_object.h.sample
EXTRA_DIST+= @swigrules@/lib/generic_object_map.cc.sample
EXTRA_DIST+= @swigrules@/lib/generic_object_map.h.sample
EXTRA_DIST+= @swigrules@/lib/printable.h.sample
EXTRA_DIST+= @swigrules@/lib/DirectorNotes.md
EXTRA_DIST+= @swigrules@/lib/serialize_support.h.sample
EXTRA_DIST+= @swigrules@/lib/blitz_array_serialize_support.h.sample
EXTRA_DIST+= @swigrules@/lib/blitz_array_serialize_support.cc.sample
EXTRA_DIST+= @swigrules@/python/swig_shelve.py.sample
EXTRA_DIST+= @swigrules@/python/swig_shelve_test.py.sample

AM_CPPFLAGS+= -I$(srcdir)/@swigrules@/lib

# Where the python package with the extension module goes.
pkgpythonswigdir = $(prefix)/@pythondir@/skeleton_swig
pkgpythonswig_LTLIBRARIES =

# The C++ code from swig_rules/lib, compiled into the library.
skeletoninc_HEADERS+= @swigrules@/lib/serialize_function.h
libskeleton_la_SOURCES+= @swigrules@/lib/serialize_function.cc
skeletoninc_HEADERS+= @swigrules@/lib/serialize_shared_ptr.h
skeletoninc_HEADERS+= @swigrules@/lib/director_hook.h
skeletoninc_HEADERS+= @swigrules@/lib/weak_ptr_serialize_support.h
libskeleton_la_SOURCES+= @swigrules@/lib/weak_ptr_serialize_support.cc
libskeleton_la_CPPFLAGS+= -DSWIG_MAPPER_NAMESPACE=Skeleton
if HAVE_BOOST_SERIALIZATION
libskeleton_la_CPPFLAGS+= -DSWIG_HAVE_BOOST_SERIALIZATION
endif

# Shortcut for building and installing just the library and python
install-python-2: install-libLTLIBRARIES install-python-skeleton install-pkgpythonswigLTLIBRARIES install-pkgpythonswigPYTHON install-pkgpythonswigDATA install-nodist_pkgpythonswigDATA
	$(noop)

install-python: all
	$(MAKE) -j 1 install-python-2
