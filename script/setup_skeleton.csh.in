# This environment variable gives us a way to move the install
# location.
if(! $?SKELETONTOP) then
    setenv SKELETONTOP @prefix@
endif

if($?PYTHONPATH) then
  setenv PYTHONPATH ${SKELETONTOP}/@pythondir@:${SKELETONTOP}/@platpythondir@:${PYTHONPATH}
else
  setenv PYTHONPATH ${SKELETONTOP}/@pythondir@:${SKELETONTOP}/@platpythondir@
endif
if ($?PATH) then
  setenv PATH ${SKELETONTOP}/bin:@pythonpath@:${PATH}
else
  setenv PATH ${SKELETONTOP}/bin:@pythonpath@
endif

