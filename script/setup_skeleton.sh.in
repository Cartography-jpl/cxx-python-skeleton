# This environment variable gives us a way to move the install
# location.
if [ -z "$SKELETONTOP" ]; then
    export SKELETONTOP=@prefix@
fi

if [ -n "$PYTHONPATH" ]; then
  export PYTHONPATH=${SKELETONTOP}/@pythondir@:${SKELETONTOP}/@platpythondir@:${PYTHONPATH}
else
  export PYTHONPATH=${SKELETONTOP}/@pythondir@:${SKELETONTOP}/@platpythondir@
fi
if [ -n "$PATH" ]; then
  export PATH=${SKELETONTOP}/bin:@pythonpath@:${PATH}
else
  export PATH=${SKELETONTOP}/bin:@pythonpath@
fi
