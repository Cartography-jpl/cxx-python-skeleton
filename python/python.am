# The skeleton python package is installed via pip rather than being
# listed file by file here - see python/setup.py and python/pyproject.toml.
# Set to a non-empty value to install the python code in editable mode.
# Default comes from configure (--enable-python-editable-mode), and can be
# overridden for a single run with "make install PYTHON_EDITABLE_MODE=t"
# (or "PYTHON_EDITABLE_MODE=" to force a normal install).
# --force-reinstall is so switching modes really replaces the existing install.
PYTHON_EDITABLE_MODE = @python_editable_mode_default@

python-install:
	if test -n "$(PYTHON_EDITABLE_MODE)"; then \
	  $(PYTHON) -m pip install --prefix=@prefix@ --force-reinstall --no-deps -e $(abs_top_srcdir)/@srcpython@; \
	else \
	  $(PYTHON) -m pip install --prefix=@prefix@ --force-reinstall --no-deps $(srcdir)/@srcpython@; \
	fi

INSTALL_EXEC_HOOK+= python-install

# Backdoor rule to do a quick install when we are just varying python
install-python-skeleton: python-install

# Make sure we don't have any pyc or pycache files floating around
DIST_HOOK += dist-clean-up-python

dist-clean-up-python:
	rm -rf `find $(distdir) -name '__pycache__'`
	rm -f `find $(distdir) -name '*.pyc'`

# Number of jobs to run at once. Default is to automatically determine this,
# but you can specify a different number.
PYTEST_NJOB=10

# Note useful flags to use here might be PYTEST_EXTRAFLAGS="--instafail" or
# PYTEST_EXTRAFLAGS="--timeout=20"
PYTEST_EXTRAFLAGS=
PYTEST_FLAGS= -q -n $(PYTEST_NJOB)

python-check: script/setup_skeleton.sh
	source $< && \
        $(PYTEST) $(PYTEST_FLAGS) $(PYTEST_EXTRAFLAGS) $(srcdir)/@srcpython@/tests $(EXTRA_PYTHON_TEST)

INSTALLCHECK_HOOK+= python-check

include python/bin/bin.am
