# Just some basic commands collected together, so I don't need to
# remember these. This is a plain Makefile, not generated by autotools
# (the top level build is autotools, but installing/checking this
# python package is simpler done directly with pip/pytest).

# We generally want to install in editable mode, so make default
install:
	pip install -e .

# Without editable mode
install2:
	pip install .

# mkinit rewrites only the block between <AUTOGEN_INIT> and
# </AUTOGEN_INIT>. Its --black needs black, which the environment doesn't
# have, so ruff formats the result instead.
update-init:
	cd skeleton && mkinit . -w --nomods --relative && ruff format __init__.py

# ------------------------------------------------------------------
# It is *not* considered an error to fail ruff/mypy - these are just
# useful extra checks, not something we require to pass. See
# README_developer.md for more on this.
# ------------------------------------------------------------------

lint:
	ruff check skeleton tests

lint-fix:
	ruff check --fix skeleton tests

format:
	ruff format skeleton tests

mypy:
	mypy --disallow-untyped-defs skeleton

# Mypy does caching from previous runs, which is usually what we
# want. Every once in a while though something get out of sync (e.g., update to pyproject.toml
# which is doesn't automatically read). This adds the
# option to run everything fresh. Takes longer, but clears up any stale cache
# issues
mypy-clear-cache:
	mypy --no-incremental --disallow-untyped-defs skeleton


check:
	pytest tests
