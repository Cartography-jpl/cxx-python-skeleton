# Just some basic commands collected together, so I don't need to
# remember these. This is a plain Makefile, not generated by autotools
# (the top level build is autotools, but installing/checking this
# python package is simpler done directly with pip/pytest).

# We generally want to install in editable mode, so make default
install:
	pip install -e .

# Without editable mode
install2:
	pip install .

# ------------------------------------------------------------------
# It is *not* considered an error to fail ruff/mypy - these are just
# useful extra checks, not something we require to pass. See
# README_developer.md for more on this.
# ------------------------------------------------------------------

lint:
	ruff check skeleton tests

lint-fix:
	ruff check --fix skeleton tests

format:
	ruff format skeleton tests

mypy:
	mypy skeleton

check:
	pytest tests
