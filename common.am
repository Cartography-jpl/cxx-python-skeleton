# This is stuff common to all our makefiles
#=================================================================
# Based on Peter Millers well known paper "Recursive Make Considered Harmful"
# (at http://miller.emu.id.au/pmiller/books/rmch/), we have the whole system
# described and built with this one Makefile.

#=================================================================
# We specify all the source directories and all of the directories we 
# install to in configure.in. We could just as sensibly defined everything
# here, but we just chose to do it there.

#=================================================================
# Tell automake to put the object file for foo/bar.c in dir foo
# Also, don't include -I. and I$(srcdir). This causes a problem with source that
# includes the C++ file "list", because libtool has a script with the same name

AUTOMAKE_OPTIONS = subdir-objects nostdinc

# Don't worry about Makefile portability warnings. We can assume that we 
# are using GNU make. Pretty much any modern system will have GNU make on it.

AUTOMAKE_OPTIONS += --warnings=no-portability

# Local autoconf packages
ACLOCAL_AMFLAGS = -I config/m4

# no operations command
noop = 

# Build these up as we go
lib_LTLIBRARIES = 
noinst_LTLIBRARIES = 
bin_PROGRAMS =
dist_bin_SCRIPTS = 
AM_LDFLAGS =
BUILT_SOURCES = 
include_HEADERS = 
EXTRA_DIST =
pkgconfig_DATA =
MOSTLYCLEANFILES =

AM_CPPFLAGS= $(SKELETON_RELEASE_CPPFLAGS) $(SKELETON_DEBUG_CPPFLAGS)
AM_CXXFLAGS= $(SKELETON_WARN_CXXFLAGS)

#=================================================================
# Sanitizer options for the tests (configure --enable-sanitizers). The
# C++ tests check for leaks, with the one accepted leak suppressed
# (script/lsan.supp); the python tests don't (python doesn't free
# everything at exit) and preload the sanitizer runtimes (see
# --enable-sanitizers in config/m4_local/skeleton_common.m4).
if SKELETON_SANITIZERS
SANITIZER_ENV = UBSAN_OPTIONS=print_stacktrace=1:halt_on_error=1:suppressions=$(abs_top_srcdir)/script/ubsan.supp \
  LSAN_OPTIONS=suppressions=$(abs_top_srcdir)/script/lsan.supp
SANITIZER_CXX_ENV = $(SANITIZER_ENV) ASAN_OPTIONS=fast_unwind_on_malloc=0
SANITIZER_PYTHON_ENV = $(SANITIZER_ENV) ASAN_OPTIONS=detect_leaks=0
SANITIZER_PRELOAD = $(SKELETON_SANITIZER_PRELOAD)
else
SANITIZER_CXX_ENV =
SANITIZER_PYTHON_ENV =
SANITIZER_PRELOAD =
endif
AM_TESTS_ENVIRONMENT = $(SANITIZER_CXX_ENV)

#=================================================================
