dist_installskeleton_SCRIPTS = 

# Make sure we don't have any pyc or pycache files floating around
DIST_HOOK = dist-clean-up-python
libskeleton_la_CPPFLAGS = $(AM_CPPFLAGS) $(BOOST_CPPFLAGS) $(BLITZ_CFLAGS)

#=================================================================
# Test coverage report. This needs a build configured with
#   CXXFLAGS="-O0 -g --coverage" LDFLAGS="--coverage"
# followed by "make install". The python tests are run against the
# python source tree (put first on PYTHONPATH, so another installed copy
# can't shadow it). This then runs the C++ and python
# tests and writes a report to coverage/ (index.html for the C++, and
# python/index.html for the python). Needs gcovr and pytest-cov. This
# isn't part of "make check". See claude_notes/implementation_plan.md
# section 4a. --merge-lines counts a line in a template as covered if any
# instance runs it (otherwise a template like Observer<T> shows as
# uncovered for every instance that a test doesn't use).
GCOVR = gcovr

#=================================================================
# C++ formatting and lint. "make format" formats the C++ with clang-format
# (.clang-format and .clang-format-ignore at the top of the source tree),
# "make format-check" only checks it (fails if a file isn't formatted).
# "make lint" runs clang-tidy with the checks in .clang-tidy and fails on any
# finding. clang-format and clang-tidy come from the pixi env (clang-tools);
# keep the same clang-format version for everyone, since the formatting
# differs slightly between versions. The file lists come from git, so these
# work in a git checkout only. The python code has the same targets in
# python/Makefile (ruff).
#
# lint also writes compile_commands.json (with the extra flags clangd needs,
# see script/make_compile_commands.py), so it can be linked into the source
# tree for clangd. clang-tidy runs on the library, test, generator and
# python binding sources in the source tree (not files generated in the
# build directory, and not nanobind's own source, nb_combined.cc).
CLANG_FORMAT = clang-format
CLANG_TIDY_FLAGS = --quiet --warnings-as-errors='*' \
  --config-file=$(abs_top_srcdir)/.clang-tidy

LINT_NJOB = 10
FORMAT_FILES = 'lib/*.h' 'lib/*.cc' 'cxx_python_rules/lib/*.h' 'cxx_python_rules/lib/*.cc' \
  'cxx_python_rules/nanobind/*.h' 'cxx_python_rules/nanobind/*.cc'

installskeleton_DATA = @srcscript@/setup_skeleton.csh @srcscript@/setup_skeleton.sh

# The skeleton python package is installed via pip rather than being
# listed file by file here - see python/setup.py and python/pyproject.toml.
# Set to a non-empty value to install the python code in editable mode.
# Default comes from configure (--enable-python-editable-mode), and can be
# overridden for a single run with "make install PYTHON_EDITABLE_MODE=t"
# (or "PYTHON_EDITABLE_MODE=" to force a normal install).
PYTHON_EDITABLE_MODE = @python_editable_mode_default@

# Number of jobs to run at once. Default is to automatically determine this,
# but you can specify a different number.
PYTEST_NJOB = 10

# Note useful flags to use here might be PYTEST_EXTRAFLAGS="--instafail" or
# PYTEST_EXTRAFLAGS="--timeout=20"
PYTEST_EXTRAFLAGS = 
PYTEST_FLAGS = -q -n $(PYTEST_NJOB)

# Where the python package with the extension module goes.
pkgpythoncxxdir = $(prefix)/@pythondir@/skeleton_cxx
pkgpythoncxx_LTLIBRARIES = $(am__append_3)
#=================================================================
# LDFLAGS for programs run from the build tree and never installed (the
# unit tests, the golden archive generator). The -rpath makes them use the
# libskeleton just built. In a conda/pixi env, LDFLAGS has
# -Wl,-rpath,$CONDA_PREFIX/lib, which automake puts ahead of libtool's own
# .libs rpath. With --prefix=$CONDA_PREFIX, after the first "make install"
# these programs then load the *installed* libskeleton, so "make check"
# silently tests the old code. LD_LIBRARY_PATH doesn't help: conda links
# with --disable-new-dtags, so this is an RPATH, not a RUNPATH. Per-target
# LDFLAGS come before $(LDFLAGS), so this puts .libs first. Don't use it for
# installed programs: it would put the build directory in their rpath.
# (Not named *_LDFLAGS: automake would take that as the flags of a
# program called UNINSTALLED_PROGRAM, and warn.)
UNINSTALLED_PROGRAM_LINK_FLAGS = -no-install -Wl,-rpath,$(abs_top_builddir)/.libs
skeleton_test_all_LDADD = libskeleton.la 
skeleton_test_all_LDFLAGS = $(UNINSTALLED_PROGRAM_LINK_FLAGS)
skeleton_test_all_CPPFLAGS = $(AM_CPPFLAGS)
NB_LIBADD = libskeleton.la
@BUILD_PYTHON_BINDINGS_TRUE@_skeleton_downstream_la_SOURCES = @srclib@/downstream_nb.cc
@BUILD_PYTHON_BINDINGS_TRUE@_skeleton_downstream_la_CPPFLAGS = $(_bindings_la_CPPFLAGS)
@BUILD_PYTHON_BINDINGS_TRUE@_skeleton_downstream_la_CXXFLAGS = $(_bindings_la_CXXFLAGS)
@BUILD_PYTHON_BINDINGS_TRUE@_skeleton_downstream_la_LDFLAGS = $(_bindings_la_LDFLAGS)
@BUILD_PYTHON_BINDINGS_TRUE@_skeleton_downstream_la_LIBADD = libnanobind_core.la libskeleton.la
NB_DOXYGEN_INPUT = $(addprefix $(srcdir)/, $(filter %.h, $(skeletoninc_HEADERS)))
golden_archive_generator_SOURCES = @srclib@/golden_archive_generator.cc
golden_archive_generator_LDADD = libskeleton.la
golden_archive_generator_LDFLAGS = $(UNINSTALLED_PROGRAM_LINK_FLAGS)
golden_archive_generator_CPPFLAGS = $(AM_CPPFLAGS) $(BOOST_CPPFLAGS) $(BLITZ_CFLAGS)
# skeleton_config.h is made by configure and installed with the headers.
nodist_skeletoninc_HEADERS = @srclib@/skeleton_config.h
@BUILD_PYTHON_BINDINGS_TRUE@libnanobind_core_la_SOURCES = @cxxpythonrules@/nanobind/nb_combined.cc
@BUILD_PYTHON_BINDINGS_TRUE@libnanobind_core_la_CPPFLAGS = $(PYTHON_CPPFLAGS) $(NANOBIND_CPPFLAGS) -I$(NANOBIND_SRCDIR)
@BUILD_PYTHON_BINDINGS_TRUE@libnanobind_core_la_CXXFLAGS = -std=c++23 -O2 -fPIC -fvisibility=hidden -fno-strict-aliasing
@BUILD_PYTHON_BINDINGS_TRUE@_bindings_la_SOURCES = $(NB_SRC) \
@BUILD_PYTHON_BINDINGS_TRUE@	@cxxpythonrules@/nanobind/cxx_python_rules_nb.cc
@BUILD_PYTHON_BINDINGS_TRUE@nodist__bindings_la_SOURCES = nb_docstrings.cc
@BUILD_PYTHON_BINDINGS_TRUE@_bindings_la_CPPFLAGS = $(AM_CPPFLAGS) \
@BUILD_PYTHON_BINDINGS_TRUE@	$(PYTHON_CPPFLAGS) \
@BUILD_PYTHON_BINDINGS_TRUE@	$(NANOBIND_CPPFLAGS) \
@BUILD_PYTHON_BINDINGS_TRUE@	-I$(srcdir)/@cxxpythonrules@/nanobind \
@BUILD_PYTHON_BINDINGS_TRUE@	-I$(srcdir)/@cxxpythonrules@/lib \
@BUILD_PYTHON_BINDINGS_TRUE@	-DCXX_PYTHON_RULES_NB_PACKAGE='"$(notdir \
@BUILD_PYTHON_BINDINGS_TRUE@	$(pkgpythoncxxdir))"'
# Not -fvisibility=hidden (nanobind recommends it, and nanobind's own code
# above has it): the binding code instantiates Boost.Serialization
# templates for library classes (director serialization), and with hidden
# visibility the module gets its own copies of their singletons, separate
# from the library's, which breaks serialization of those classes.
@BUILD_PYTHON_BINDINGS_TRUE@_bindings_la_CXXFLAGS = $(AM_CXXFLAGS)
# No -lpython: the interpreter provides the symbols.
@BUILD_PYTHON_BINDINGS_TRUE@_bindings_la_LDFLAGS = -module -avoid-version -shared
@BUILD_PYTHON_BINDINGS_TRUE@_bindings_la_LIBADD = libnanobind_core.la $(NB_LIBADD)
@BUILD_PYTHON_BINDINGS_TRUE@pkgpythoncxx_PYTHON =  \
@BUILD_PYTHON_BINDINGS_TRUE@	@cxxpythonrules@/__init__.py \
@BUILD_PYTHON_BINDINGS_TRUE@	@cxxpythonrules@/all.py \
@BUILD_PYTHON_BINDINGS_TRUE@	@cxxpythonrules@/_nanobind_support.py
@BUILD_PYTHON_BINDINGS_TRUE@pkgpythoncxx_DATA = @cxxpythonrules@/py.typed
@BUILD_PYTHON_BINDINGS_TRUE@nodist_pkgpythoncxx_DATA = nb_pyi/_bindings.pyi
all: $(BUILT_SOURCES)
	$(MAKE) $(AM_MAKEFLAGS) all-am

.SUFFIXES:
.SUFFIXES: .cc .lo .log .o .obj .test .test$(EXEEXT) .trs
am--refresh: Makefile
	@:
$(srcdir)/Makefile.in: @MAINTAINER_MODE_TRUE@ $(srcdir)/Makefile.am $(srcdir)/common.am $(srcdir)/include.am $(srcdir)/skeleton.am $(srcdir)/script/script.am $(srcdir)/python/python.am $(srcdir)/python/bin/bin.am $(srcdir)/cxx_python_rules/cxx_python_rules.am $(srcdir)/lib/lib.am $(srcdir)/cxx_python_rules/nanobind/nanobind.am $(srcdir)/unit_test_data/unit_test_data.am $(am__configure_deps)
	@for dep in $?; do \
	  case '$(am__configure_deps)' in \
	    *$$dep*) \
	      echo ' cd $(srcdir) && $(AUTOMAKE) --gnu'; \
	      $(am__cd) $(srcdir) && $(AUTOMAKE) --gnu \
		&& exit 0; \
	      exit 1;; \
	  esac; \
	done; \
	echo ' cd $(top_srcdir) && $(AUTOMAKE) --gnu Makefile'; \
	$(am__cd) $(top_srcdir) && \
	  $(AUTOMAKE) --gnu Makefile
Makefile: $(srcdir)/Makefile.in $(top_builddir)/config.status
	@case '$?' in \
	  *config.status*) \
	    echo ' $(SHELL) ./config.status'; \
	    $(SHELL) ./config.status;; \
	  *) \
	    echo ' cd $(top_builddir) && $(SHELL) ./config.status $@ $(am__maybe_remake_depfiles)'; \
	    cd $(top_builddir) && $(SHELL) ./config.status $@ $(am__maybe_remake_depfiles);; \
	esac;
$(srcdir)/common.am $(srcdir)/include.am $(srcdir)/skeleton.am $(srcdir)/script/script.am $(srcdir)/python/python.am $(srcdir)/python/bin/bin.am $(srcdir)/cxx_python_rules/cxx_python_rules.am $(srcdir)/lib/lib.am $(srcdir)/cxx_python_rules/nanobind/nanobind.am $(srcdir)/unit_test_data/unit_test_data.am $(am__empty):

$(top_builddir)/config.status: $(top_srcdir)/configure $(CONFIG_STATUS_DEPENDENCIES)
	$(SHELL) ./config.status --recheck

$(top_srcdir)/configure: @MAINTAINER_MODE_TRUE@ $(am__configure_deps)
	$(am__cd) $(srcdir) && $(AUTOCONF)
$(ACLOCAL_M4): @MAINTAINER_MODE_TRUE@ $(am__aclocal_m4_deps)
	$(am__cd) $(srcdir) && $(ACLOCAL) $(ACLOCAL_AMFLAGS)
$(am__aclocal_m4_deps):

lib/skeleton_build_config.h: lib/stamp-h1
	@test -f $@ || rm -f lib/stamp-h1
	@test -f $@ || $(MAKE) $(AM_MAKEFLAGS) lib/stamp-h1

lib/stamp-h1: $(top_srcdir)/lib/skeleton_build_config.h.in $(top_builddir)/config.status
	$(AM_V_at)rm -f lib/stamp-h1
	$(AM_V_GEN)cd $(top_builddir) && $(SHELL) ./config.status lib/skeleton_build_config.h
$(top_srcdir)/lib/skeleton_build_config.h.in: @MAINTAINER_MODE_TRUE@ $(am__configure_deps) 
	$(AM_V_GEN)($(am__cd) $(top_srcdir) && $(AUTOHEADER))
	$(AM_V_at)rm -f lib/stamp-h1
	$(AM_V_at)touch $@

distclean-hdr:
	-rm -f lib/skeleton_build_config.h lib/stamp-h1
script/setup_skeleton.csh: $(top_builddir)/config.status $(top_srcdir)/script/setup_skeleton.csh.in
	cd $(top_builddir) && $(SHELL) ./config.status $@
script/setup_skeleton.sh: $(top_builddir)/config.status $(top_srcdir)/script/setup_skeleton.sh.in
	cd $(top_builddir) && $(SHELL) ./config.status $@
lib/skeleton_config.h: $(top_builddir)/config.status $(top_srcdir)/lib/skeleton_config.h.in
	cd $(top_builddir) && $(SHELL) ./config.status $@
lib/global_fixture_default.cc: $(top_builddir)/config.status $(top_srcdir)/lib/global_fixture_default.cc.in
	cd $(top_builddir) && $(SHELL) ./config.status $@
install-binPROGRAMS: $(bin_PROGRAMS)
	@$(NORMAL_INSTALL)
	@list='$(bin_PROGRAMS)'; test -n "$(bindir)" || list=; \
	if test -n "$$list"; then \
	  echo " $(MKDIR_P) '$(DESTDIR)$(bindir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(bindir)" || exit 1; \
	fi; \
	for p in $$list; do echo "$$p $$p"; done | \
	sed 's/$(EXEEXT)$$//' | \
	while read p p1; do if test -f $$p \
	 || test -f $$p1 \
	  ; then echo "$$p"; echo "$$p"; else :; fi; \
	done | \
	sed -e 'p;s,.*/,,;n;h' \
	    -e 's|.*|.|' \
	    -e 'p;x;s,.*/,,;s/$(EXEEXT)$$//;$(transform);s/$$/$(EXEEXT)/' | \
	sed 'N;N;N;s,\n, ,g' | \
	$(AWK) 'BEGIN { files["."] = ""; dirs["."] = 1 } \
	  { d=$$3; if (dirs[d] != 1) { print "d", d; dirs[d] = 1 } \
	    if ($$2 == $$4) files[d] = files[d] " " $$1; \
	    else { print "f", $$3 "/" $$4, $$1; } } \
	  END { for (d in files) print "f", d, files[d] }' | \
	while read type dir files; do \
	    if test "$$dir" = .; then dir=; else dir=/$$dir; fi; \
	    test -z "$$files" || { \
	    echo " $(INSTALL_PROGRAM_ENV) $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL_PROGRAM) $$files '$(DESTDIR)$(bindir)$$dir'"; \
	    $(INSTALL_PROGRAM_ENV) $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL_PROGRAM) $$files "$(DESTDIR)$(bindir)$$dir" || exit $$?; \
	    } \
	; done

uninstall-binPROGRAMS:
	@$(NORMAL_UNINSTALL)
	@list='$(bin_PROGRAMS)'; test -n "$(bindir)" || list=; \
	files=`for p in $$list; do echo "$$p"; done | \
	  sed -e 'h;s,^.*/,,;s/$(EXEEXT)$$//;$(transform)' \
	      -e 's/$$/$(EXEEXT)/' \
	`; \
	test -n "$$list" || exit 0; \
	echo " ( cd '$(DESTDIR)$(bindir)' && rm -f" $$files ")"; \
	cd "$(DESTDIR)$(bindir)" && $(am__rm_f) $$files

clean-binPROGRAMS:
	$(am__rm_f) $(bin_PROGRAMS)
	test -z "$(EXEEXT)" || $(am__rm_f) $(bin_PROGRAMS:$(EXEEXT)=)

clean-checkPROGRAMS:
	$(am__rm_f) $(check_PROGRAMS)
	test -z "$(EXEEXT)" || $(am__rm_f) $(check_PROGRAMS:$(EXEEXT)=)

install-libLTLIBRARIES: $(lib_LTLIBRARIES)
	@$(NORMAL_INSTALL)
	@list='$(lib_LTLIBRARIES)'; test -n "$(libdir)" || list=; \
	list2=; for p in $$list; do \
	  if test -f $$p; then \
	    list2="$$list2 $$p"; \
	  else :; fi; \
	done; \
	test -z "$$list2" || { \
	  echo " $(MKDIR_P) '$(DESTDIR)$(libdir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(libdir)" || exit 1; \
	  echo " $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL) $(INSTALL_STRIP_FLAG) $$list2 '$(DESTDIR)$(libdir)'"; \
	  $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL) $(INSTALL_STRIP_FLAG) $$list2 "$(DESTDIR)$(libdir)"; \
	}

uninstall-libLTLIBRARIES:
	@$(NORMAL_UNINSTALL)
	@list='$(lib_LTLIBRARIES)'; test -n "$(libdir)" || list=; \
	for p in $$list; do \
	  $(am__strip_dir) \
	  echo " $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=uninstall rm -f '$(DESTDIR)$(libdir)/$$f'"; \
	  $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=uninstall rm -f "$(DESTDIR)$(libdir)/$$f"; \
	done

clean-libLTLIBRARIES:
	-$(am__rm_f) $(lib_LTLIBRARIES)
	@list='$(lib_LTLIBRARIES)'; \
	locs=`for p in $$list; do echo $$p; done | \
	      sed 's|^[^/]*$$|.|; s|/[^/]*$$||; s|$$|/so_locations|' | \
	      sort -u`; \
	echo rm -f $${locs}; \
	$(am__rm_f) $${locs}

clean-noinstLTLIBRARIES:
	-$(am__rm_f) $(noinst_LTLIBRARIES)
	@list='$(noinst_LTLIBRARIES)'; \
	locs=`for p in $$list; do echo $$p; done | \
	      sed 's|^[^/]*$$|.|; s|/[^/]*$$||; s|$$|/so_locations|' | \
	      sort -u`; \
	echo rm -f $${locs}; \
	$(am__rm_f) $${locs}

install-pkgpythoncxxLTLIBRARIES: $(pkgpythoncxx_LTLIBRARIES)
	@$(NORMAL_INSTALL)
	@list='$(pkgpythoncxx_LTLIBRARIES)'; test -n "$(pkgpythoncxxdir)" || list=; \
	list2=; for p in $$list; do \
	  if test -f $$p; then \
	    list2="$$list2 $$p"; \
	  else :; fi; \
	done; \
	test -z "$$list2" || { \
	  echo " $(MKDIR_P) '$(DESTDIR)$(pkgpythoncxxdir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(pkgpythoncxxdir)" || exit 1; \
	  echo " $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL) $(INSTALL_STRIP_FLAG) $$list2 '$(DESTDIR)$(pkgpythoncxxdir)'"; \
	  $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL) $(INSTALL_STRIP_FLAG) $$list2 "$(DESTDIR)$(pkgpythoncxxdir)"; \
	}

uninstall-pkgpythoncxxLTLIBRARIES:
	@$(NORMAL_UNINSTALL)
	@list='$(pkgpythoncxx_LTLIBRARIES)'; test -n "$(pkgpythoncxxdir)" || list=; \
	for p in $$list; do \
	  $(am__strip_dir) \
	  echo " $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=uninstall rm -f '$(DESTDIR)$(pkgpythoncxxdir)/$$f'"; \
	  $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=uninstall rm -f "$(DESTDIR)$(pkgpythoncxxdir)/$$f"; \
	done

clean-pkgpythoncxxLTLIBRARIES:
	-$(am__rm_f) $(pkgpythoncxx_LTLIBRARIES)
	@list='$(pkgpythoncxx_LTLIBRARIES)'; \
	locs=`for p in $$list; do echo $$p; done | \
	      sed 's|^[^/]*$$|.|; s|/[^/]*$$||; s|$$|/so_locations|' | \
	      sort -u`; \
	echo rm -f $${locs}; \
	$(am__rm_f) $${locs}
