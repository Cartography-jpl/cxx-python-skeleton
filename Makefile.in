# ========================================================================
# An error we run into every once in a while is somebody trying to build
# after having doing a setup_afids_env. The problem with this is that
# the AFIDS distribution contains a program "sort" that interfers with the
# unix sort.

complain_if_afids:
	@if test -n "${AFIDSTOP}"; then \
          echo "${red}You have sourced setup_afids_env.sh or setup_afids_env.csh.";  \
          echo "This will cause the build to *fail*, because MIPL has";  \
          echo "a program called 'sort' that interferes with the unix";  \
          echo "sort command. You need to restart the build *without*"; \
          echo "sourcing setup_afids_env.sh or setup_afids_env.csh${default}"; \
          exit 1; \
        fi
coverage:
	find . -name '*.gcda' -delete
	rm -rf coverage
	$(MKDIR_P) coverage/python
	$(MAKE) $(AM_MAKEFLAGS) skeleton-check
	source script/setup_skeleton.sh && \
	  cd $(srcdir)/@srcpython@ && \
	  PYTHONPATH=$(abs_top_srcdir)/@srcpython@:$$PYTHONPATH \
	  COVERAGE_FILE=$(abs_builddir)/coverage/.coverage $(PYTEST) -q \
	  -p no:cacheprovider --cov=skeleton --cov-report=term \
	  --cov-report=html:$(abs_builddir)/coverage/python tests
	$(GCOVR) -r $(realpath $(abs_top_srcdir)) . \
	  --filter '$(realpath $(abs_top_srcdir))/(lib|cxx_python_rules/lib)/' \
	  --exclude '.*_test\.cc' --exclude '.*golden_archive_generator.*' \
	  --exclude '.*(global_fixture|test_all).*' \
	  --merge-lines --print-summary --html-details coverage/index.html
	@echo "Coverage report in coverage/index.html and coverage/python/index.html"

.PHONY: coverage

format:
	cd $(srcdir) && git ls-files $(FORMAT_FILES) | xargs -r $(CLANG_FORMAT) -i

format-check:
	cd $(srcdir) && git ls-files $(FORMAT_FILES) | \
	  xargs -r $(CLANG_FORMAT) --dry-run --Werror

lint:
	$(PYTHON) $(srcdir)/script/make_compile_commands.py --clangd \
	  libskeleton.la skeleton_test_all golden_archive_generator _bindings.la \
	  _skeleton_downstream.la
	$(PYTHON) -c 'import json, os; src = os.path.realpath("$(abs_top_srcdir)") + "/"; [print(e["file"]) for e in json.load(open("compile_commands.json")) if os.path.realpath(e["file"]).startswith(src) and not e["file"].endswith("nb_combined.cc")]' \
	  > lint_files.txt
	@test -s lint_files.txt || { echo "lint: no source files found in compile_commands.json"; exit 1; }
	xargs -r -P $(LINT_NJOB) -n 1 sh $(srcdir)/script/run_clang_tidy.sh $(CLANG_TIDY_FLAGS) < lint_files.txt
	@echo "clang-tidy: no findings in $$(wc -l < lint_files.txt) files"

.PHONY: format format-check lint

# We uninstall any existing install in the prefix first. pip install
# --force-reinstall doesn't do this reliably: it doesn't remove the files
# of a normal install when switching to editable mode (the left over copy
# in site-packages then shadows the editable install), and it uninstalls
# "skeleton" from whatever python environment pip sees, not just from
# the prefix (e.g. a configure --prefix=/tmp/x build removed the copy in
# the conda environment). So uninstall explicitly from the prefix, then
# install with --ignore-installed, which leaves everything else alone.
# pip uninstall has no --prefix, so point PYTHONPATH at the prefix's
# site-packages so it finds the install there first. Only do this if there is an install in the prefix: otherwise pip
# would go on to find (and remove) one somewhere else on sys.path, e.g.
# the python environment's own site-packages.
python-install:
	if ls -d @prefix@/@pythondir@/skeleton-*.dist-info > /dev/null 2>&1; then \
	  PYTHONPATH=@prefix@/@pythondir@ $(PYTHON) -m pip uninstall -y -q skeleton; \
	fi
	if test -n "$(PYTHON_EDITABLE_MODE)"; then \
	  $(PYTHON) -m pip install --prefix=@prefix@ --ignore-installed --no-deps -e $(abs_top_srcdir)/@srcpython@; \
	else \
	  $(PYTHON) -m pip install --prefix=@prefix@ --ignore-installed --no-deps $(srcdir)/@srcpython@; \
	fi

# Backdoor rule to do a quick install when we are just varying python
install-python-skeleton: python-install

dist-clean-up-python:
	rm -rf `find $(distdir) -name '__pycache__'`
	rm -f `find $(distdir) -name '*.pyc'`

python-check: script/setup_skeleton.sh
	source $< && \
        $(PYTEST) $(PYTEST_FLAGS) $(PYTEST_EXTRAFLAGS) $(srcdir)/@srcpython@/tests $(EXTRA_PYTHON_TEST)

#=================================================================
# The python tests against the build tree (part of "make check", no
# install needed): the extension modules from .libs and the python
# packages from the source tree, in nb_pkg/. libskeleton is preloaded,
# since the modules' RPATH (conda links with --disable-new-dtags) would
# otherwise find an installed libskeleton first, as in ST.11.
@BUILD_PYTHON_BINDINGS_TRUE@python-check-build: all
@BUILD_PYTHON_BINDINGS_TRUE@	rm -rf nb_pkg && $(MKDIR_P) nb_pkg/skeleton_cxx
@BUILD_PYTHON_BINDINGS_TRUE@	for f in __init__.py all.py _nanobind_support.py py.typed; do \
@BUILD_PYTHON_BINDINGS_TRUE@	  ln -s $(abs_top_srcdir)/@cxxpythonrules@/$$f nb_pkg/skeleton_cxx/$$f; done
@BUILD_PYTHON_BINDINGS_TRUE@	for m in _bindings _skeleton_downstream; do \
@BUILD_PYTHON_BINDINGS_TRUE@	  ln -s $(abs_builddir)/.libs/$$m.so nb_pkg/skeleton_cxx/$$m.so; done
@BUILD_PYTHON_BINDINGS_TRUE@	ln -s $(abs_top_srcdir)/@srcpython@/skeleton nb_pkg/skeleton
@BUILD_PYTHON_BINDINGS_TRUE@	cd $(srcdir)/@srcpython@ && \
@BUILD_PYTHON_BINDINGS_TRUE@	  PYTHONPATH=$(abs_builddir)/nb_pkg:$$PYTHONPATH \
@BUILD_PYTHON_BINDINGS_TRUE@	  LD_PRELOAD=$(abs_builddir)/.libs/libskeleton.so \
@BUILD_PYTHON_BINDINGS_TRUE@	  $(PYTEST) $(PYTEST_FLAGS) -p no:cacheprovider $(PYTEST_EXTRAFLAGS) tests $(EXTRA_PYTHON_TEST)
@BUILD_PYTHON_BINDINGS_TRUE@clean-nb-pkg:
@BUILD_PYTHON_BINDINGS_TRUE@	rm -rf nb_pkg
# CXX_PYTHON_RULES_NAMESPACE and CXX_PYTHON_RULES_HAVE_BOOST_SERIALIZATION
# come from the project's configuration header (configure.ac), not from
# the command line, so installed headers work without extra flags.

# Shortcut for building and installing just the library and python
install-python-2: install-libLTLIBRARIES install-python-skeleton install-pkgpythoncxxLTLIBRARIES install-pkgpythoncxxPYTHON install-pkgpythoncxxDATA install-nodist_pkgpythoncxxDATA
	$(noop)

install-python: all
	$(MAKE) -j 1 install-python-2

golden-archives: golden_archive_generator
	source script/setup_skeleton.sh && \
	./golden_archive_generator $(abs_top_srcdir)/@unittestdata@/golden

# Variables used in testing
export abs_top_srcdir 
export abs_top_builddir
export testdatadir
export run_test = *

#=================================================================
# Normally check builds all the libraries, and tests all the pyton. This
# version builds just what is needed for C++ unit tests, which is faster
# to do during development.

skeleton-check: $(BUILT_SOURCES)
	$(MAKE) $(AM_MAKEFLAGS) skeleton-check-am

skeleton-check-am: skeleton_test_all
	@echo "====================================================="
	@echo "This just builds and runs the skeleton C++ unit tests"
	@echo "(useful during development). It does run the python "
	@echo "tests, use check for that"
	@echo "====================================================="
	$(srcdir)/$(srclib)/test_all.sh

# Allow searchs for .i, .h. and .cc files in this directory
vpath %.cc $(srcdir)/@srclib@
vpath %.h $(srcdir)/@srclib@
vpath %.i $(srcdir)/@srclib@

# Docstrings from the doxygen documentation of NB_DOXYGEN_INPUT. Without
# doxygen, the table is empty.
@BUILD_PYTHON_BINDINGS_TRUE@nb_docstrings.cc: $(NB_DOXYGEN_INPUT) @cxxpythonrules@/nanobind/doxy2nanobind.py @cxxpythonrules@/nanobind/doxygen_nanobind.cfg
@BUILD_PYTHON_BINDINGS_TRUE@	rm -rf nb_doc && mkdir -p nb_doc
@BUILD_PYTHON_BINDINGS_TRUE@	if test -n "$(DOXYGEN)" -a "$(DOXYGEN)" != "no"; then \
@BUILD_PYTHON_BINDINGS_TRUE@	  OUTDIR=nb_doc INPUT="$(NB_DOXYGEN_INPUT)" $(DOXYGEN) $(srcdir)/@cxxpythonrules@/nanobind/doxygen_nanobind.cfg > /dev/null; \
@BUILD_PYTHON_BINDINGS_TRUE@	fi
@BUILD_PYTHON_BINDINGS_TRUE@	$(PYTHON) $(srcdir)/@cxxpythonrules@/nanobind/doxy2nanobind.py nb_doc/xml $@.tmp
@BUILD_PYTHON_BINDINGS_TRUE@	mv $@.tmp $@
@BUILD_PYTHON_BINDINGS_TRUE@	rm -rf nb_doc

# Python stubs (.pyi) for mypy and editors, from the built module.
@BUILD_PYTHON_BINDINGS_TRUE@nb_pyi/_bindings.pyi: _bindings.la
@BUILD_PYTHON_BINDINGS_TRUE@	rm -rf nb_pyi && mkdir -p nb_pyi/$(notdir $(pkgpythoncxxdir))
@BUILD_PYTHON_BINDINGS_TRUE@	cp $(srcdir)/@cxxpythonrules@/__init__.py $(srcdir)/@cxxpythonrules@/_nanobind_support.py nb_pyi/$(notdir $(pkgpythoncxxdir))/
@BUILD_PYTHON_BINDINGS_TRUE@	cp .libs/_bindings$(PYTHON_EXT_SUFFIX_SO) nb_pyi/$(notdir $(pkgpythoncxxdir))/ 2>/dev/null || cp .libs/_bindings.so nb_pyi/$(notdir $(pkgpythoncxxdir))/
@BUILD_PYTHON_BINDINGS_TRUE@	cd nb_pyi && PYTHONPATH=.:$${PYTHONPATH} LD_LIBRARY_PATH=$(abs_top_builddir)/.libs:$${LD_LIBRARY_PATH} \
@BUILD_PYTHON_BINDINGS_TRUE@	  $(PYTHON) -m nanobind.stubgen -m $(notdir $(pkgpythoncxxdir))._bindings -o _bindings.pyi -q
@BUILD_PYTHON_BINDINGS_TRUE@	rm -rf nb_pyi/$(notdir $(pkgpythoncxxdir))

# Nothing here yet, but put in place as a placeholder

# Tell versions [3.59,3.63) of GNU make to not export all variables.
# Otherwise a system limit (for SysV at least) may be exceeded.
.NOEXPORT:

# Tell GNU make to disable its built-in pattern rules.
%:: %,v
%:: RCS/%,v
%:: RCS/%
%:: s.%
%:: SCCS/s.%
