	-rm -rf @cxxpythonrules@/lib/.libs @cxxpythonrules@/lib/_libs
	-rm -rf @cxxpythonrules@/nanobind/.libs @cxxpythonrules@/nanobind/_libs
	-rm -rf @srclib@/.libs @srclib@/_libs

distclean-libtool:
	-rm -f libtool config.lt
install-pkgpythoncxxPYTHON: $(pkgpythoncxx_PYTHON)
	@$(NORMAL_INSTALL)
	@list='$(pkgpythoncxx_PYTHON)'; dlist=; list2=; test -n "$(pkgpythoncxxdir)" || list=; \
	if test -n "$$list"; then \
	  echo " $(MKDIR_P) '$(DESTDIR)$(pkgpythoncxxdir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(pkgpythoncxxdir)" || exit 1; \
	fi; \
	for p in $$list; do \
	  if test -f "$$p"; then b=; else b="$(srcdir)/"; fi; \
	  if test -f $$b$$p; then \
	    $(am__strip_dir) \
	    dlist="$$dlist $$f"; \
	    list2="$$list2 $$b$$p"; \
	  else :; fi; \
	done; \
	for file in $$list2; do echo $$file; done | $(am__base_list) | \
	while read files; do \
	  echo " $(INSTALL_DATA) $$files '$(DESTDIR)$(pkgpythoncxxdir)'"; \
	  $(INSTALL_DATA) $$files "$(DESTDIR)$(pkgpythoncxxdir)" || exit $$?; \
	done || exit $$?; \
	if test -n "$$dlist"; then \
	  $(am__py_compile) --destdir "$(DESTDIR)" \
	                    --basedir "$(pkgpythoncxxdir)" $$dlist; \
	else :; fi

uninstall-pkgpythoncxxPYTHON:
	@$(NORMAL_UNINSTALL)
	@list='$(pkgpythoncxx_PYTHON)'; test -n "$(pkgpythoncxxdir)" || list=; \
	py_files=`for p in $$list; do echo $$p; done | sed -e 's|^.*/||'`; \
	test -n "$$py_files" || exit 0; \
	dir='$(DESTDIR)$(pkgpythoncxxdir)'; \
	pyc_files=`echo "$$py_files" | sed 's|$$|c|'`; \
	pyo_files=`echo "$$py_files" | sed 's|$$|o|'`; \
	st=0; \
	for files in "$$py_files" "$$pyc_files" "$$pyo_files"; do \
	  $(am__uninstall_files_from_dir) || st=$$?; \
	done; \
	dir='$(DESTDIR)$(pkgpythoncxxdir)'; \
	files=`echo "$$py_files" | $(am__pep3147_tweak)`; \
	$(am__uninstall_files_from_dir) || st=$$?; \
	exit $$st
